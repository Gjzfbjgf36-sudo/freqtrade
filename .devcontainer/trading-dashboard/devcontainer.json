{
    "name": "Trading-Projekt (Bot + Dashboard)",
    "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "forwardPorts": [
        8080
    ],
    "portsAttributes": {
        "8080": {
            "label": "Freqtrade + Dashboard",
            "protocol": "http",
            "onAutoForward": "notify"
        }
    },
    "onCreateCommand": "bash .devcontainer/trading-dashboard/setup.sh",
    "postStartCommand": "bash .devcontainer/trading-dashboard/start.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ],
            "settings": {
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            }
        }
    }
}
